{
  "name": "telecode",
  "version": "1.1.0",
  "description": "Telegram bridge for Claude / Kiro / Codex / Cursor CLI — vibecode from anywhere on macOS, Linux, Windows",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "telecode": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/session && cp src/session/schema.sql dist/session/schema.sql && chmod +x dist/cli/kiro-gate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:e2e": "TELECODE_E2E=1 vitest run tests/e2e/",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.145",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/runner": "2.0.3",
    "async-mutex": "0.5.0",
    "better-sqlite3": "12.10.0",
    "execa": "9.6.1",
    "grammy": "1.43.0",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
